# ==============================================================================
# VARIABLES DE ENTORNO - GESTOR DE FINANZAS
# Copie este archivo como .env en la raiz del proyecto y configure sus credenciales
# ==============================================================================

# URL de la instancia de Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave publica anonima de Supabase (Project Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Correos con privilegios de administrador en frontend (separados por coma, opcional)
VITE_ADMIN_EMAILS=admin@dominio.com
